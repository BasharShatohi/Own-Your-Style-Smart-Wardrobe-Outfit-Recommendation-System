# Optional. Without it the service still runs, just without a public tunnel.
# Get one at https://dashboard.ngrok.com/authtokens
NGROK_AUTH_TOKEN=

# Path to the ngrok binary. The default suits Linux/Colab; set this on Windows.
NGROK_PATH=

# Where the Laravel API is reachable from this service.
LARAVEL_URL=http://127.0.0.1:8000
